# Vercel's Redis store (Storage tab -> Create Database -> Redis).
# It gives you a single REDIS_URL connection string automatically once
# attached to this project — no manual copying needed on Vercel itself.
REDIS_URL=

# Any long random string — used to sign session cookies (HMAC).
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Comma-separated list of emails allowed into /admin (e.g. your own
# account email once you sign up). No separate admin system needed.
ADMIN_EMAILS=

# Optional but recommended — email notifications via Resend
# (resend.com, free tier). Without this, the site works fine, it just
# won't send any emails (new bookings, applications, etc. will only
# show up in the admin dashboard).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Your site's real URL, used only to build links inside emails
# (e.g. https://health365-app1.vercel.app). Optional.
NEXT_PUBLIC_SITE_URL=

# Vercel Blob — used for real image uploads from /admin/content
# (Storage tab -> Create Database -> Blob). Modern Blob connections use
# Vercel's OIDC auth automatically — you do NOT need to set
# BLOB_READ_WRITE_TOKEN manually for a project deployed on Vercel with
# the store connected. This is only needed for local development.
BLOB_READ_WRITE_TOKEN=

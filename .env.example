# Vercel KV — created automatically when you attach a KV store to this
# project in the Vercel dashboard (Storage tab). Copy the values it gives
# you here for local development; on Vercel itself these are injected
# automatically once the store is attached, no manual copying needed.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Any long random string — used to sign session cookies (HMAC).
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Comma-separated list of emails allowed into /admin (e.g. your own
# account email once you sign up). No separate admin system needed.
ADMIN_EMAILS=
